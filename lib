    def extract_table_data(self, tbody_locator: str, timeout: int = 30) -> list[dict] | None:
        try:
            time.sleep(5)
            tbody = self.wait_for_element(tbody_locator, typeVal="xpath", timeout=timeout)
            
            # Opcjonalnie ustaw zoom
            self.set_browser_zoom(0.65)
            
            # NAGŁÓWKI - z scrollowaniem
            headers = self.driver.find_elements(By.XPATH, "//thead/tr/th | //thead/tr/td")
            header_arr = []
            
            for cell in headers:
                try:
                    # Scrolluj do nagłówka (ważne przy poziomym scrollu!)
                    self.driver.execute_script("arguments[0].scrollIntoView({block: 'nearest', inline: 'center'});", cell)
                    
                    # Twoja oryginalna logika pobierania tekstu
                    try:
                        span = cell.find_element(By.XPATH, ".//span")
                        text = span.text.strip()
                    except Exception:
                        text = cell.text.strip()
                        
                    if text:  # Zachowujesz tylko niepuste nagłówki
                        header_arr.append(text)
                        
                except Exception as e:
                    logging.warning(f"Błąd przy pobieraniu nagłówka: {e}")
                    continue
            
            logging.info(f"Pobrano {len(header_arr)} nagłówków: {header_arr}")
            
            # WIERSZE - z scrollowaniem
            rows = tbody.find_elements(By.CSS_SELECTOR, "#dataExplorerTableBody1 > tr")
            
            if not rows:
                logging.warning("Nie znaleziono żadnych wierszy <tr> w tbody.")
                return []
            
            data = []
            
            for row_idx, row in enumerate(rows):
                try:
                    # Scrolluj do wiersza
                    
                    self.driver.execute_script("arguments[0].scrollIntoView({block: 'center', inline: 'nearest'});", row)
                    
                    cells = row.find_elements(By.TAG_NAME, "td")
                    values = []
                    
                    for cell in cells:
                        try:
                            # Scrolluj do komórki (przy szerokich tabelach)
                        
                            self.driver.execute_script("arguments[0].scrollIntoView({block: 'nearest', inline: 'center'});", cell)
                            
                            # Twoja oryginalna logika pobierania tekstu
                            try:
                                span = cell.find_element(By.XPATH, ".//span")
                                text = span.text.strip()
                            except Exception:
                                text = cell.text.strip()
                            
                            # WAŻNE: zachowujesz swoją logikę filtrowania!
                            if text != "" and len(text) > 1:
                                values.append(text)
                                
                        except Exception as e:
                            # Pomijamy błędne komórki
                            continue
                    
                    # Łączysz nagłówki z wartościami - tak jak w oryginale
                    row_dict = dict(zip(header_arr, values))
                    data.append(row_dict)
                    
                except Exception as e:
                    logging.error(f"Błąd przy przetwarzaniu wiersza #{row_idx}: {e}")
                    continue
            
            logging.info(f"Pobrano {len(data)} wierszy z tabeli.")
            # print("moja data to", data)
            return data
            
        except Exception as e:
            logging.error(f"Błąd podczas pobierania danych z tabeli: {e}")
            return None

    def extract_oracle_grid_tab(self) -> list[dict] | None:
        try:
            #pobierz nagłówki z headerTable ----- uwaga ---- id może się róznić --- trzeba przd metodą przeładować iframe
            header_tbl = self.driver.find_element(By.ID, "headerTable")
            h_cells = header_tbl.find_elements(By.XPATH, ".//th|.//td")
           
            raw_headers = []
            for h in h_cells:
                txt = h.text.strip() or h.get_attribute("textContent").strip()
                raw_headers.append(txt)

            # pomijam pierwsze puste kolumny („+”,„–”)
            header_arr = [h for h in raw_headers if h]

            #pobierz wiersze danych
            tbody = self.driver.find_element(By.ID, "dataTableBody")
            rows = tbody.find_elements(By.XPATH, ".//tr")
            data = []

            for r in rows:
                cells = r.find_elements(By.TAG_NAME, "td")
                # pomiń pierwsze 2 kolumny plus/minus
                logic_cells = cells[2:] if len(cells) > 2 else cells
                row_values = []

                for c in logic_cells:
                    val = ""

                    # checkbox
                    if c.find_elements(By.XPATH, ".//input[@type='checkbox']"):
                        chk = c.find_element(By.XPATH, ".//input[@type='checkbox']")
                        val = "X" if chk.is_selected() or chk.get_attribute("checked") else ""

                    # select (tylko wybrana opcja ✔)
                    elif c.find_elements(By.XPATH, ".//select"):
                        sel_el = c.find_element(By.TAG_NAME, "select")
                        try:
                            sel = Select(sel_el)
                            selected_opt = sel.first_selected_option
                            val = (
                                selected_opt.text.strip()
                                or selected_opt.get_attribute("value")
                                or ""
                            )
                        except Exception:
                            # awaryjny fallback
                            val = sel_el.get_attribute("value") or ""

                    # input text
                    elif c.find_elements(By.XPATH, ".//input[@type='text']"):
                        inp = c.find_element(By.XPATH, ".//input[@type='text']")
                        val = inp.get_attribute("value") or ""

                    # span
                    elif c.find_elements(By.XPATH, ".//span"):
                        sp = c.find_element(By.XPATH, ".//span")
                        val = sp.text.strip() or sp.get_attribute("textContent").strip()

                    # zwykły tekst międzytagowy
                    else:
                        txt = c.text.strip()
                        if txt:
                            val = txt

                    row_values.append(val)

                # dopasuj długość / nagłówków
                if len(row_values) < len(header_arr):
                    row_values += [""] * (len(header_arr) - len(row_values))
                elif len(row_values) > len(header_arr):
                    row_values = row_values[:len(header_arr)]

                data.append(dict(zip(header_arr, row_values)))

            logging.info(f"Pobrano {len(data)} wierszy z Oracle gridu.")
            return data
        except Exception as e:
            logging.error(f"Błąd podczas parsowania Oracle gridu: {e}")
            return None
        

