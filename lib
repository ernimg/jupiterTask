            # Wszystkie statusy wymagające pełnej weryfikacji (z poprzedniego przykładu)
            pelna_weryfikacja = [
                "Oczekiwanie na wysłanie zlecenia OT",
                "Pobranie danych ze sprawy referencyjnej", 
                "Pobranie daty działania w terenie i aktualizacja daty umowy",
                "Przekazanie parametrów umowy do SID",
                "Weryfikacja aktualizacji parametrów odczytowych",
                "Weryfikacja błędu wysłania aktywacji umowy do SID",
                "Weryfikacja obowiązku informacyjnego",
                "Weryfikacja typu subskrypcji",
                "Weryfikacja zakładania subskrypcji",
                "Wybór typu umowy",
                "Weryfikacja anulowania zgłoszenia przez sprzedawcę"
            ]

            for data in table_data:
                liczba_dni_minelo = self.ile_dni_minelo(data.get('CREATION_DTTM'))
                status = data.get("STATUS")
                typSprawy = data.get("TYP SPRAWY")
                id = data.get("ID SPRAWY")

                # Pomijamy inne typy spraw
                if typSprawy != "Zawarcie umowy dystrybucyjnej z wniosku":
                    continue

                # Statusy końcowe
                if status in STATUSY_ZAKONCZONE:
                    rezult.append({"toDo": True, "mesage": status, "days": liczba_dni_minelo})
                    continue

                # Statusy proste (tylko dodanie wpisu)
                if status in STATUSY_PROSTE:
                    config = STATUSY_PROSTE[status]
                    if config.get("print_only"):
                        print({"toDo": config["toDo"], "mesage": status, "days": liczba_dni_minelo})
                    else:
                        rezult.append({"toDo": config["toDo"], "mesage": status, "days": liczba_dni_minelo})
                    continue

                # Statusy wymagające weryfikacji nip/person
                if status in STATUSY_WERYFIKACYJNE:
                    self._weryfikuj_sprawe(data, person_excel, nip_excel, rezult, liczba_dni_minelo, status, id, 
                                        STATUSY_WERYFIKACYJNE[status])
                    continue

                # Statusy z pełną weryfikacją (jak w poprzednim przykładzie)
                if status in pelna_weryfikacja:
                    self._weryfikuj_sprawe(data, person_excel, nip_excel, rezult, liczba_dni_minelo, status, id, 
                                        {"toDo": False, "toWeryfi_prawidlowe": True, "toWeryfi_nip_rozne": True})
                    continue
        else:
            rezult.append({"toDo": True, "mesage": "Anulowana (zakończona negatywnie)", "days":"0"})

        print("wynik: ", rezult)
        return rezult


    def _weryfikuj_sprawe(self, data, person_excel, nip_excel, rezult, liczba_dni_minelo, status, id, config):
        """Wspólna metoda do weryfikacji nip i person"""
        try:
            idSpr = self.wait_for_element(data['ID SPRAWY'], "text")
            idSpr.click()
            self.reset_frame()
            self.switch_iframe("tabPage")
            self.switch_iframe("zoneMapFrame_1")
            
            person_link = self.wait_for_element('//*[@id="personId"]/a')
            person_link.click()
            self.reset_frame()
            self.switch_iframe("tabPage")
            self.switch_iframe("PER_NAME")
            
            person = self.wait_for_element('//*[@id="PER_NAME:0$ENTITY_NAME"]').get_attribute("value")
            
            self.reset_frame()
            self.switch_iframe("tabPage")
            self.switch_iframe("PER_IDENTIFIER")
            
            # Pobranie NIP z grida
            grid_data = self.extract_oracle_grid_tab()
            nip = None
            for row in grid_data:
                if row.get("TYP IDENTYFIKATORA") == "NIP":
                    nip = row.get('NUMER IDENTYFIKACYJNY')
                    break
            
            # Porównanie NIP i person
            if str(nip).strip() == str(nip_excel).strip():
                if person != person_excel:
                    final_mesage = f"Dla sprawy od id: {id} nip jest zgodny lecz nazwy osoby są różne: wartość z CC&B: {person} | wartość z excel: {person_excel}"
                    rezult.append({
                        "toDo": False,
                        "toWeryfi": True,
                        "mesage": status,
                        "days": liczba_dni_minelo,
                        "person": person,
                        "pesonExcel": person_excel,
                        "nip": nip,
                        "nip_excel": nip_excel,
                        "final_mesage": final_mesage
                    })
                else:  # person == person_excel
                    final_mesage = f"Dla sprawy od id: {id} nip jest zgodny oraz nazwy osoby są zgodne - sprawa o danych parametrach istnieje."
                    rezult.append({
                        "toDo": config["toDo"],
                        "toWeryfi": config["toWeryfi_prawidlowe"],
                        "mesage": status,
                        "days": liczba_dni_minelo,
                        "person": person,
                        "pesonExcel": person_excel,
                        "nip": nip,
                        "nip_excel": nip_excel,
                        "final_mesage": final_mesage
                    })
            else:  # NIP się nie zgadza
                final_mesage = f"Dla sprawy od id: {id} nip jest inny - do weryfikacji zakładam sprawę"
                rezult.append({
                    "toDo": True,
                    "toWeryfi": config["toWeryfi_nip_rozne"],
                    "mesage": status,
                    "days": liczba_dni_minelo,
                    "person": person,
                    "pesonExcel": person_excel,
                    "nip": nip,
                    "nip_excel": nip_excel,
                    "final_mesage": final_mesage
                })
        
        finally:
            # Zawsze wracamy do poprzedniego widoku
            self.reset_frame()
            back_btn = self.wait_for_element('//*[@id="IM_GOBACK"]')
            back_btn.click()
            time.sleep(3)
            back_btn.click()
            time.sleep(3)
            self.reset_frame()
            self.switch_iframe("tabPage")
        
    
