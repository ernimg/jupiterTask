    def set_browser_zoom(self, zoom_level: float):
        """
        Ustawia poziom powiększenia (zoom) w przeglądarce Edge na poziomie renderowania.
        Działa przez Chrome DevTools Protocol (CDP), bez modyfikacji DOM ani symulacji klawiszy.
        
        :param zoom_level: Wartość dziesiętna (np. 0.65 = 65%, 1.0 = 100%)
        """
        try:
            self.driver.execute_cdp_cmd("Emulation.setDeviceMetricsOverride", {
                "width":  self.driver.execute_script("return window.outerWidth;"),
                "height": self.driver.execute_script("return window.outerHeight;"),
                "deviceScaleFactor": zoom_level,  # Skalowanie całego interfejsu
                "mobile": False,
                "screenOrientation": {"angle": 0, "type": "portraitPrimary"},
                "scale": 1
            })
            self.write_file_log("log.txt", f"🔍 Zoom przeglądarki ustawiony na {int(zoom_level * 100)}%")
        except Exception as e:
            # Jeśli CDP nie wspiera tej komendy, zaloguj błąd
            self.write_file_log("log.txt", f"❌ Nie udało się ustawić zoomu: {str(e)}")

