    def compare_names_similarity(self, name1, name2):
        import re
        from difflib import SequenceMatcher

        def normalize_text(text):
            """Normalizuje tekst do porównania - ulepszona wersja z pełną obsługą form prawnych"""
            if not text or str(text).strip().lower() in ["NaN", "nan", "none"]:
                return ""

            # Konwersja na string, małe litery, obcinanie
            text = str(text).lower().strip()
            
            # Zamiana polskich znaków
            polish_chars = {
                'ą': 'a', 'ć': 'c', 'ę': 'e', 'ł': 'l', 'ń': 'n', 
                'ó': 'o', 'ś': 's', 'ź': 'z', 'ż': 'z'
            }
            for polish, basic in polish_chars.items():
                text = text.replace(polish, basic)
            
            # Usuń znaki interpunkcyjne i zbędne spacje
            text = re.sub(r'[^\w\s]', ' ', text)
            text = re.sub(r'\s+', ' ', text).strip()
            
            # *** NOWE: usuwanie typów ulic ***
            # ul., ulica, al., aleja, pl., plac, os., osiedle, skwer, rondo itp.
            street_prefixes = [
                r'\bul\.?\b',
                r'\bulica\b',
                r'\bal\.?\b',
                r'\baleja\b',
                r'\bpl\.?\b',
                r'\bplac\b',
                r'\bos\.?\b',
                r'\bosiedle\b',
                r'\bskwer\b',
                r'\brondo\b'
            ]
            for pattern in street_prefixes:
                text = re.sub(pattern, ' ', text)

            # ponownie zbij nadmiarowe spacje po usunięciu prefiksów
            text = re.sub(r'\s+', ' ', text).strip()


            # --- KLUCZOWE: Pełna obsługa form prawnych ---
            # Spółka z ograniczoną odpowiedzialnością (wszystkie warianty)
            text = re.sub(r'\bsp\s*z\s*o\s*o\s*\b', 'spolka z ograniczona odpowiedzialnoscia', text)
            text = re.sub(r'\bsp\.?\s*z\.?\s*o\.?o\.?\b', 'spolka z ograniczona odpowiedzialnoscia', text)
            text = re.sub(
                r'\bsp[oó]lka\s+z\s+ograniczon[aą]\s+odpowiedzialno[sś][ci]\b',
                'spolka z ograniczona odpowiedzialnoscia',
                text
            )

            # Spółka akcyjna
            text = re.sub(r'\bs\.?a\.?\b', 'spolka akcyjna', text)
            text = re.sub(r'\bsp[oó]lka\s+akcyjna\b', 'spolka akcyjna', text)

            # Prosta spółka akcyjna
            text = re.sub(r'\bp\.?s\.?a\.?\b', 'prosta spolka akcyjna', text)
            text = re.sub(r'\bprosta\s+sp[oó]lka\s+akcyjna\b', 'prosta spolka akcyjna', text)

            # Spółka jawna
            text = re.sub(r'\bsp\.?\s*j\.?\b', 'spolka jawna', text)
            text = re.sub(r'\bsp[oó]lka\s+jawna\b', 'spolka jawna', text)

            # Spółka partnerska
            text = re.sub(r'\bsp\.?\s*p\.?\b', 'spolka partnerska', text)
            text = re.sub(r'\bsp[oó]lka\s+partnerska\b', 'spolka partnerska', text)

            # Spółka komandytowa
            text = re.sub(r'\bsp\.?\s*k\.?\b', 'spolka komandytowa', text)
            text = re.sub(r'\bsp[oó]lka\s+komandytowa\b', 'spolka komandytowa', text)

            # Unifikuj słowa kluczowe
            text = re.sub(r'\bodpowiedzialnosci?\b', 'odpowiedzialnosc', text)
            text = re.sub(r'\bakcyjn[ae]?\b', 'akcyjna', text)
            text = re.sub(r'\bjawn[ae]?\b', 'jawna', text)
            text = re.sub(r'\bkomandytn[ae]?\b', 'komandytowa', text)
            text = re.sub(r'\bpartner(?:ski|ska)?\b', 'partnerska', text)

            return text.strip()

        def jaro_winkler_similarity(s1, s2):
            """Oblicza podobieństwo Jaro-Winkler"""
            if not s1 or not s2:
                return 0.0
            if s1 == s2:
                return 1.0
            
            len1, len2 = len(s1), len(s2)
            match_window = max(len1, len2) // 2 - 1
            match_window = max(0, match_window)
            
            s1_matches = [False] * len1
            s2_matches = [False] * len2
            matches = 0
            
            for i in range(len1):
                start = max(0, i - match_window)
                end = min(i + match_window + 1, len2)
                
                for j in range(start, end):
                    if s2_matches[j] or s1[i] != s2[j]:
                        continue
                    s1_matches[i] = s2_matches[j] = True
                    matches += 1
                    break
            
            if matches == 0:
                return 0.0
            
            k = 0
            transpositions = 0
            for i in range(len1):
                if not s1_matches[i]:
                    continue
                while not s2_matches[k]:
                    k += 1
                if s1[i] != s2[k]:
                    transpositions += 1
                k += 1
            
            jaro = (matches / len1 + matches / len2 + (matches - transpositions/2) / matches) / 3
            
            prefix = 0
            for i in range(min(len(s1), len(s2), 4)):
                if s1[i] == s2[i]:
                    prefix += 1
                else:
                    break
            
            return jaro + prefix * 0.1 * (1 - jaro)

        def token_similarity(s1, s2):
            """Oblicza podobieństwo na podstawie tokenów (słów)"""
            tokens1 = set(s1.split())
            tokens2 = set(s2.split())
            
            if not tokens1 and not tokens2:
                return 1.0
            if not tokens1 or not tokens2:
                return 0.0
            
            intersection = len(tokens1.intersection(tokens2))
            union = len(tokens1.union(tokens2))
            return intersection / union if union > 0 else 0.0

        # --- GŁÓWNA LOGIKA ---
        norm1 = normalize_text(name1)
        norm2 = normalize_text(name2)

        # Sprawdź przypadki graniczne
        if not norm1 and not norm2:
            return {
                'similarity_percentage': 100.0,
                'differences': [],
                'normalized_comparison': 'Oba teksty są puste',
                'analysis_method': 'empty_comparison'
            }

        if not norm1 or not norm2:
            return {
                'similarity_percentage': 0.0,
                'differences': [f"Jedna z nazw jest pusta: '{name1}' vs '{name2}'"],
                'normalized_comparison': f"'{norm1}' vs '{norm2}'",
                'analysis_method': 'empty_field'
            }

        # Oblicz podobieństwa różnymi metodami
        jaro_sim = jaro_winkler_similarity(norm1, norm2)
        token_sim = token_similarity(norm1, norm2)
        seq_sim = SequenceMatcher(None, norm1, norm2).ratio()

        # Kombinuj wyniki z wagami
        weights = [0.4, 0.35, 0.25]  # jaro_winkler, token, sequence
        combined_sim = (
            jaro_sim * weights[0] + 
            token_sim * weights[1] + 
            seq_sim * weights[2]
        ) * 100

        # Znajdź różnice
        differences = []
        words1 = norm1.split()
        words2 = norm2.split()

        extra_words = set(words1) - set(words2)
        if extra_words:
            differences.append(f"Nazwa z CC&B: {', '.join(sorted(extra_words))}")

        missing_words = set(words2) - set(words1)
        if missing_words:
            differences.append(f"Nazwa z excel: {', '.join(sorted(missing_words))}")

        # Porównanie znak po znaku (tylko jeśli długości są bliskie)
        if abs(len(words1) - len(words2)) <= 2:
            matcher = SequenceMatcher(None, norm1, norm2)
            for tag, i1, i2, j1, j2 in matcher.get_opcodes():
                if tag == 'replace' and len(norm1[i1:i2]) > 1 and len(norm2[j1:j2]) > 1:
                    differences.append(f"Zamiana: '{norm1[i1:i2]}' → '{norm2[j1:j2]}'")
                elif tag == 'delete' and len(norm1[i1:i2]) > 1:
                    differences.append(f"Usunięte: '{norm1[i1:i2]}'")
                elif tag == 'insert' and len(norm2[j1:j2]) > 1:
                    differences.append(f"Dodane: '{norm2[j1:j2]}'")

        # Określ metodę analizy
        method = 'combined'
        if jaro_sim >= 0.85:
            method = 'jaro_winkler'
        elif token_sim >= 0.8:
            method = 'token_based'
        elif seq_sim >= 0.8:
            method = 'sequence_matching'

        return {
            'similarity_percentage': round(combined_sim, 2),
            'differences': differences if differences else ['Teksty są identyczne'],
            'normalized_comparison': f"'{norm1}' vs '{norm2}'",
            'analysis_method': method,
            'jaro_winkler_score': round(jaro_sim * 100, 2),
            'token_score': round(token_sim * 100, 2),
            'sequence_score': round(seq_sim * 100, 2)
        }

    # Funkcja pomocnicza do pracy z listami
    def compare_multiple_names(self,name_to_find, name_list, min_similarity=70):
        """
        Porównuje jedną nazwę z listą innych nazw
        
        Args:
            name_to_find (str): Nazwa do znalezienia
            name_list (list): Lista nazw do porównania
            min_similarity (float): Minimalne podobieństwo do pokazania
        
        Returns:
            list: Lista dopasowanych wyników posortowanych według podobieństwa
        """
        results = []
        
        for name in name_list:
            result = self.compare_names_similarity(name_to_find, name)
            results.append({
                'reference_name': name_to_find,
                'matched_name': name,
                'similarity': result['similarity_percentage'],
                'differences': result['differences']
            })
        
        # Filtruj i sortuj wyniki
        filtered_results = [r for r in results if r['similarity'] >= min_similarity]
        return sorted(filtered_results, key=lambda x: x['similarity'], reverse=True)
    
    def detect_date_format(self,date_string):
        # Funkcja normalizująca niestandardowe znaki
        def normalize_date_string(s):
            # Zamienia niestandardowe myślniki na standardowy myślnik
            non_standard_dashes = '‑–—―'  # en dash, em dash, horizontal bar
            standard_dash = '-'
            translation_table = str.maketrans(non_standard_dashes, standard_dash * len(non_standard_dashes))
            return s.translate(translation_table)
        
        # Normalizuj string
        normalized_string = normalize_date_string(date_string)
        
        # Lista formatów z czasem
        date_time_formats = [
            "%Y-%m-%d %H:%M:%S",   # 2024-07-24 12:13:59
            "%d-%m-%Y %H:%M:%S",   # 24-07-2024 12:13:59
            "%m-%d-%Y %H:%M:%S",   # 07-24-2024 12:13:59
            "%Y/%m/%d %H:%M:%S",   # 2024/07/24 12:13:59
            "%d/%m/%Y %H:%M:%S",   # 24/07/2024 12:13:59
            "%m/%d/%Y %H:%M:%S",   # 07/24/2024 12:13:59
            "%Y.%m.%d %H:%M:%S",   # 2024.07.24 12:13:59
            "%d.%m.%Y %H:%M:%S",   # 24.07.2024 12:13:59
            "%m.%d.%Y %H:%M:%S",   # 07.24.2024 12:13:59
            "%d %B %Y %H:%M:%S",   # 24 July 2024 12:13:59
            "%B %d, %Y %H:%M:%S",  # July 24, 2024 12:13:59
            "%b %d, %Y %H:%M:%S",  # Jul 24, 2024 12:13:59
            "%Y%m%d %H:%M:%S",     # 20240724 12:13:59
            "%d-%b-%Y %H:%M:%S",   # 24-Jul-2024 12:13:59
            "%b-%d-%Y %H:%M:%S",   # Jul-24-2024 12:13:59
            "%d %b %Y %H:%M:%S",   # 24 Jul 2024 12:13:59
            "%H:%M:%S %d-%m-%Y",   # 12:13:59 24-07-2024
            "%H:%M:%S %Y-%m-%d",   # 12:13:59 2024-07-24
        ]
        
        # Lista formatów bez czasu
        date_formats = [
            "%Y-%m-%d",       # 2024-07-24
            "%d-%m-%Y",       # 24-07-2024
            "%m-%d-%Y",       # 07-24-2024
            "%Y/%m/%d",       # 2024/07/24
            "%d/%m/%Y",       # 24/07/2024
            "%m/%d/%Y",       # 07/24/2024
            "%Y.%m.%d",       # 2024.07.24
            "%d.%m.%Y",       # 24.07.2024
            "%m.%d.%Y",       # 07.24.2024
            "%d %B %Y",       # 24 July 2024
            "%B %d, %Y",      # July 24, 2024
            "%b %d, %Y",      # Jul 24, 2024
            "%Y%m%d",         # 20240724
            "%d-%b-%Y",       # 24-Jul-2024
            "%b-%d-%Y",       # Jul-24-2024
            "%d %b %Y",       # 24 Jul 2024
        ]
        
        # Połącz formaty (najpierw z czasem, potem bez)
        combined_formats = date_time_formats + date_formats
        
        # Sprawdź każdy format
        for fmt in combined_formats:
            try:
                datetime.strptime(normalized_string, fmt)
                return fmt
            except ValueError:
                continue
        
        return None

    def ile_dni_minelo(self, data_string: str) -> int | None:
        
        if not data_string:
                print(f"Błąd: Próba przetworzenia pustej daty.")
                return None
        data_string_czysta = data_string[:2] + "-" + data_string[3:5] + "-" + data_string[6:10] + " " + data_string[11:13] + ":" + data_string[14:16] + ":" + data_string[17:]
        try:
            data_wejsciowa_dt = datetime.strptime(data_string_czysta,"%d-%m-%Y %H:%M:%S")
            print("data wyejsciowa",data_wejsciowa_dt)
            aktualna_data_dt = datetime.now()
            roznica = aktualna_data_dt - data_wejsciowa_dt
            return roznica.days
        except ValueError as val:
            print(val)
            print(f"Błąd: Nieprawidłowy format daty '{data_string}'. Po oczyszczeniu nadal nie pasuje do DD-MM-YYYY HH:MM:SS.")
