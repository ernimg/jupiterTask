    def wait_for_element(self, locator,typeVal = "xpath", condition=EC.presence_of_element_located ,timeout=50, poll_frequency=0.5):
        # param locator: Krotka zawierająca metodę wyszukiwania, np. (By.XPATH, "//div[@id='example']")
        # param condition: Warunek z expected_conditions (domyślnie presence_of_element_located)
        # param timeout: Maksymalny czas oczekiwania w sekundach (domyślnie 10)
        # param poll_frequency: Częstotliwość sprawdzania warunku (domyślnie 0.5 sekundy)
        # return: Znaleziony element WebElement lub wyjątek TimeoutException, jeśli warunek nie zostanie spełniony
        ignored_exceptions = (NoSuchElementException, StaleElementReferenceException)
        wait = WebDriverWait(self.driver, timeout, poll_frequency, ignored_exceptions=ignored_exceptions)
        try:
            match typeVal:
                case "xpath":
                    element = wait.until(condition((By.XPATH,locator)))
                    return element
                case "text":
                    element = wait.until(condition((By.XPATH,f'//*[text()="{locator}"]')))
                    return element
                case "id":
                    element = wait.until(condition((By.ID,locator)))
                    return element
                case "name":
                    element = wait.until(condition((By.NAME,f'//*[@name="{locator}"]')))
                    return element
                case "tag":
                    element = wait.until(condition((By.TAG_NAME,locator)))
                    return element
                case "css":
                    element = wait.until(condition((By.CSS_SELECTOR,locator)))

        except TimeoutException as e:
            logging.error(f"Element {locator} nie pojawił się w ciągu {timeout} sekund.")
            self.driver.save_screenshot("timeout_screenshot.png")
            raise e
        

